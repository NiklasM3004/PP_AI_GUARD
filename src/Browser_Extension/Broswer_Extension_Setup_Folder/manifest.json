{
  "manifest_version": 3,
  "name": "Gemini Guard",
  "version": "1.0",
  "permissions": ["background"],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"]
    }
  ]
}